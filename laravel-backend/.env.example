APP_NAME="Demo NGO (DEMO) API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- DEMO Platform Settings (ported from FastAPI config.py) ---
PROJECT_NAME="Demo NGO (DEMO) API"
PROJECT_VERSION=2.0.0
ENVIRONMENT=development

# M-2: explicit opt-in for dev-only payment conveniences (sandbox checkouts,
# unsigned webhooks in dev, gateway-free completion). NEVER set to true in production;
# production refuses to boot with this enabled.
ALLOW_DEV_PAYMENT_BYPASSES=true
PAYMENTS_ENABLED=true
# Fail-open email realism check on new ticket checkouts (blocklist + MX + SMTP probe).
# Set to false only as an emergency kill switch.
EMAIL_EXISTENCE_CHECK=true
# Generate at deploy: php -r "echo base64_encode(random_bytes(32));"
# Weak/template secrets hard-fail in production (AppServiceProvider::enforceJwtSecretStrength)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC_demomedia
PAYSTACK_SECRET_KEY=
# Monthly pledge collection (config/roi.php): reminder offsets in days after
# the due date, per-run email cap, billing timezone, secure-link TTL.
PLEDGE_REMINDER_DAYS=1,3,7
PLEDGE_EMAIL_BATCH_SIZE=25
PLEDGE_TIMEZONE=Africa/Nairobi
PLEDGE_PAYMENT_LINK_TTL_HOURS=168
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_SHORTCODE=000001
MPESA_WEBHOOK_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
