APP_NAME="Demo NGO (DEMO) API"
APP_ENV=production
APP_KEY=<generated-application-key>
APP_DEBUG=false
APP_URL=https://example.org

ENVIRONMENT=production
ALLOW_DEV_PAYMENT_BYPASSES=false
PAYMENTS_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<dedicated-cpanel-database>
DB_USERNAME=<dedicated-cpanel-database-user>
DB_PASSWORD=<database-password>

JWT_SECRET_KEY=<new-random-secret-at-least-32-bytes>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<bcrypt-or-argon-hash-from-hidden-prompt>

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC_demomedia
YOUTUBE_CRON_SECRET=<new-random-cron-secret>
PAYSTACK_SECRET_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_SHORTCODE=
MPESA_WEBHOOK_TOKEN=
