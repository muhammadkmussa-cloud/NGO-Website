{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend: Uvicorn Debugger",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Frontend React: Launch Chrome against Localhost",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full-Stack ROI Ecosystem (Backend + Frontend Debug)",
      "configurations": [
        "FastAPI Backend: Uvicorn Debugger",
        "Frontend React: Launch Chrome against Localhost"
      ]
    }
  ]
}
