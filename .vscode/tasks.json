{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Backend Server (FastAPI)",
      "type": "shell",
      "command": "python3 -m uvicorn backend.main:app --reload --port 8000",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Start Frontend Server (React Vite)",
      "type": "shell",
      "command": "npm run dev -- --port 3000",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 Start Demo Full-Stack Ecosystem (VS Code Concurrently)",
      "dependsOn": [
        "1. Start Backend Server (FastAPI)",
        "2. Start Frontend Server (React Vite)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
