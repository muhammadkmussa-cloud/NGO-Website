# ====================================================================
# Demo NGO (DEMO) - Production Environment Store Template
# Stack: Laravel 13 API + Vanilla HTML/CSS/JS SPA
# ====================================================================

# --- Laravel application ---
APP_NAME="Demo NGO (DEMO) API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# --- DEMO lifecycle switch (development / test enables seeding + sandbox payments) ---
ENVIRONMENT=production
PAYMENTS_ENABLED=false

# --- Database (SQLite for dev; Supabase PostgreSQL for production) ---
# Dev:
#   DB_CONNECTION=sqlite
# Production (Supabase):
DB_CONNECTION=pgsql
DB_HOST=db.YOUR-PROJECT.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=[YOUR-PASSWORD]

# --- Security & Single Admin Slot Auth (consumed by config/roi.php) ---
JWT_SECRET_KEY=your_256bit_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your_laravel_hash_make_admin_password_hash

# --- External Live API Keys ---
YOUTUBE_API_KEY=your_live_google_cloud_youtube_api_key
YOUTUBE_CHANNEL_ID=UC_demomedia

PAYSTACK_SECRET_KEY=sk_live_your_actual_paystack_secret_key

MPESA_CONSUMER_KEY=your_live_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_live_daraja_consumer_secret
MPESA_PASSKEY=your_live_daraja_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/webhook/mpesa
MPESA_SHORTCODE=000001

# Hardened webhook shared secret (recommended): appended to the Daraja
# CallBackURL as ?token=... and verified on every inbound callback.
MPESA_WEBHOOK_TOKEN=generate_a_long_random_string
